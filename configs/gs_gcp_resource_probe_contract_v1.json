{
  "schema": "gs_gcp_resource_probe_contract_v1",
  "contract_id": "gs_gcp_external_resource_probe_1hz_v1",
  "implementation": "code/gcp/run_with_resource_probe.py",
  "sampling": {
    "gpu_interval_seconds": 1.0,
    "gpu_interval_tolerance_seconds": 0.25,
    "gpu_source": "nvidia-smi",
    "host_source": "isolated GNU time 1.9 -v",
    "explicit_gpu_indices_required_for_gpu_phase": true
  },
  "host_tool": {
    "installation_mode": "apt_download_and_dpkg_extract_no_global_install",
    "expected_path": "/root/autodl-tmp/tools/gs-gcp-v13/gnu-time/ubuntu-jammy-time-1.9-v1/root/usr/bin/time",
    "binary_sha256": "7310b9b4c51a8f4d26c1af0da250f03a49ec8a8141033123e79196ad18f6c81b",
    "tool_manifest_sha256": "122d801b8eb6fd1f6f7c643b566802fb54bf36a578088705e613caa4e450f637",
    "ubuntu_package_version": "1.9-0.1build2",
    "deb_sha256": "ec6009fa2e3931fb2c0046668c828e9ee87a1ccc154239ea7a2925301ff4d518"
  },
  "phase_types": [
    "preprocess",
    "train",
    "render",
    "packet_export",
    "evaluation"
  ],
  "gpu_required_phases": [
    "train",
    "render",
    "packet_export"
  ],
  "required_gpu_query_fields": [
    "timestamp_utc",
    "monotonic_seconds",
    "gpu_index",
    "gpu_uuid",
    "gpu_name",
    "driver_version",
    "memory_used_mib",
    "memory_total_mib",
    "utilization_gpu_percent",
    "power_draw_watts"
  ],
  "required_summary_fields": [
    "wall_seconds",
    "allocated_gpu_count",
    "gpu_hours",
    "peak_gpu_memory_mib",
    "mean_gpu_utilization_percent",
    "max_gpu_utilization_percent",
    "estimated_gpu_energy_wh",
    "maximum_resident_set_size_kib",
    "child_exit_code",
    "probe_complete"
  ],
  "gpu_hours_formula": "wall_seconds * allocated_gpu_count / 3600",
  "energy_formula": "left_riemann_sum_of_per_gpu_power_watts_over_monotonic_sample_intervals / 3600",
  "non_invasive": {
    "training_source_changes_allowed": false,
    "autograd_instrumentation_allowed": false,
    "loss_instrumentation_allowed": false,
    "child_command_shell_allowed": false
  },
  "output_files": {
    "command": "command.json",
    "gpu_samples": "gpu_samples.csv",
    "gnu_time": "gnu_time.txt",
    "stdout": "stdout.log",
    "stderr": "stderr.log",
    "summary": "resource_summary.json"
  },
  "overwrite_policy": "fail_if_output_directory_exists"
}
